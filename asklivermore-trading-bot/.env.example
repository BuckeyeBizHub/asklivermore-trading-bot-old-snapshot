# ============================================================
# AskLivermore Trading Bot - Environment Configuration
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Mode ---
EXECUTION_MODE=paper            # scan-only | paper | live | replay
BROKER=alpaca                   # alpaca | ibkr
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
TIMEZONE=America/New_York

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
REASONING_MODEL=claude-opus-4-7
UTILITY_MODEL=claude-haiku-4-5-20251001

# --- Polygon (real-time market data) ---
POLYGON_API_KEY=
POLYGON_WEBSOCKET_URL=wss://socket.polygon.io/stocks

# --- Alpaca (paper or live) ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # https://api.alpaca.markets for live

# --- IBKR (live trading via ib_insync / IB Gateway) ---
IBKR_HOST=127.0.0.1
IBKR_PORT=7497                 # 7497 paper, 7496 live
IBKR_CLIENT_ID=42
IBKR_ACCOUNT=

# --- Risk caps ---
MAX_RISK_PCT=0.02              # 2% per trade
MAX_DAILY_LOSS_PCT=0.03        # 3% daily kill
MAX_DRAWDOWN_PCT=0.08          # 8% trailing kill
MAX_OPEN_POSITIONS=5
HEARTBEAT_TIMEOUT_S=120

# --- Confluence gate ---
MIN_CONFLUENCE_SCORE=4
MIN_SENTIMENT_SCORE=0.0

# --- Graphify ---
GRAPHIFY_URL=http://graphify:7000
GRAPHIFY_API_KEY=
GRAPHIFY_NAMESPACE=asklivermore

# --- Social media skill / enrichment ---
MARKETAUX_API_KEY=
STYVIO_API_KEY=

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMS_PROVIDER=                  # twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_TO=

# --- External repo paths (override if you cloned elsewhere) ---
EXTERNAL_PATH_GRAPHIFY=./external/graphify
EXTERNAL_PATH_SOCIAL_SKILLS=./external/social-media-skills
EXTERNAL_PATH_CLAUDE_PEERS=./external/claude-peers

# --- CSV ingest ---
CSV_IMPORT_DIR=./data/csv_imports
CSV_SCHEMA_PATH=./core/csv_schema.yaml

# --- Peers (claude-peers messaging) ---
PEER_ID=primary
PEER_TOPIC=asklivermore-trading
